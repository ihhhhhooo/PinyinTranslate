<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <ApplicationManifest>../../src/PinyinTranslate.App/app.manifest</ApplicationManifest>
    <DefineConstants Condition="'$(IncludeLegacyUia2Probe)' == 'true'">$(DefineConstants);LEGACY_UIA2_PROBE</DefineConstants>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="FlaUI.UIA3" Version="5.0.0" />
  </ItemGroup>
</Project>
