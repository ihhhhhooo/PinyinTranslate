<Window x:Class="PinyinTranslate.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="PinyinTranslate" Width="1020" Height="700" MinWidth="740" MinHeight="590"
        WindowStartupLocation="CenterScreen" Background="{DynamicResource Canvas}" Foreground="{DynamicResource Ink}" FontFamily="Microsoft YaHei UI">
    <Window.Resources>
        <Style x:Key="Card" TargetType="Border">
            <Setter Property="Background" Value="{DynamicResource Surface}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource CardBorder}"/>
            <Setter Property="BorderThickness" Value="{DynamicResource CardBorderThickness}"/>
            <Setter Property="CornerRadius" Value="{DynamicResource CardCornerRadius}"/>
            <Setter Property="Effect" Value="{DynamicResource PanelShadow}"/>
            <Setter Property="Padding" Value="20,18"/>
        </Style>
        <Style x:Key="FeatureBadge" TargetType="Border">
            <Setter Property="Width" Value="36"/><Setter Property="Height" Value="36"/>
            <Setter Property="CornerRadius" Value="{DynamicResource BadgeCornerRadius}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource CardBorder}"/>
            <Setter Property="BorderThickness" Value="{DynamicResource ControlBorderThickness}"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>
        <Style x:Key="SideNav" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="HorizontalContentAlignment" Value="Left"/>
            <Setter Property="Margin" Value="0,0,0,8"/>
            <Setter Property="MinHeight" Value="44"/>
            <Setter Property="Padding" Value="12,8"/>
        </Style>
    </Window.Resources>
    <Grid>
    <Grid.ColumnDefinitions><ColumnDefinition Width="150"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
    <Border Background="{DynamicResource Surface}" BorderBrush="{DynamicResource CardBorder}" BorderThickness="0,0,1,0">
        <DockPanel Margin="12,20,12,16">
            <TextBlock DockPanel.Dock="Bottom" Text="本机数据" Foreground="{DynamicResource Muted}" FontSize="11" Margin="8,12,0,0"/>
            <StackPanel>
                <StackPanel Orientation="Horizontal" Margin="5,0,0,26">
                    <Border Width="31" Height="31" Background="{DynamicResource HeaderBadge}" CornerRadius="{DynamicResource BadgeCornerRadius}" BorderBrush="{DynamicResource CardBorder}" BorderThickness="{DynamicResource ControlBorderThickness}">
                        <Path Data="{DynamicResource IconBrand}" Stroke="{DynamicResource HeaderBadgeText}" StrokeThickness="1.7" Width="17" Height="17" Stretch="Uniform"/>
                    </Border>
                    <StackPanel Margin="8,0,0,0" VerticalAlignment="Center"><TextBlock Text="翻译助手" FontWeight="Bold" FontSize="14"/><TextBlock Text="PinyinTranslate" Foreground="{DynamicResource Muted}" FontSize="9" FontFamily="Segoe UI"/></StackPanel>
                </StackPanel>
                <Button x:Name="HomeNav" Style="{StaticResource SideNav}" Click="OpenHome" AutomationProperties.Name="打开翻译主页">
                    <StackPanel Orientation="Horizontal"><Path Data="M4,10 L12,4 L20,10 L20,20 L4,20 Z M9,20 L9,14 L15,14 L15,20" Stroke="{DynamicResource ButtonInk}" StrokeThickness="1.6" StrokeLineJoin="Round" Width="17" Height="17" Stretch="Uniform" Margin="0,0,10,0"/><TextBlock Text="翻译" FontWeight="SemiBold"/></StackPanel>
                </Button>
                <Button x:Name="StatisticsNav" Style="{StaticResource SideNav}" Click="OpenStatistics" AutomationProperties.Name="打开统计">
                    <StackPanel Orientation="Horizontal"><Path Data="M4,20 L4,13 L8,13 L8,20 Z M10,20 L10,8 L14,8 L14,20 Z M16,20 L16,4 L20,4 L20,20 Z" Stroke="{DynamicResource ButtonInk}" StrokeThickness="1.6" StrokeLineJoin="Round" Width="17" Height="17" Stretch="Uniform" Margin="0,0,10,0"/><TextBlock Text="统计" FontWeight="SemiBold"/></StackPanel>
                </Button>
                <Button x:Name="SettingsButton" Style="{StaticResource SideNav}" Click="OpenSettings" AutomationProperties.Name="打开设置">
                    <StackPanel Orientation="Horizontal"><Path Data="M12,3 L12,5 M12,19 L12,21 M3,12 L5,12 M19,12 L21,12 M5.6,5.6 L7,7 M17,17 L18.4,18.4 M18.4,5.6 L17,7 M7,17 L5.6,18.4 M12,8 A4,4 0 1 1 11.9,8" Stroke="{DynamicResource ButtonInk}" StrokeThickness="1.7" Width="17" Height="17" Stretch="Uniform" Margin="0,0,10,0"/><TextBlock Text="设置" FontWeight="SemiBold"/></StackPanel>
                </Button>
            </StackPanel>
        </DockPanel>
    </Border>
    <Grid x:Name="MainContent" Grid.Column="1">
    <ScrollViewer x:Name="HomeView" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <Grid x:Name="HomeLayout" Margin="30,25,30,30" MaxWidth="840">
            <Grid.ColumnDefinitions><ColumnDefinition x:Name="HomeLeft" Width="*"/><ColumnDefinition x:Name="HomeGap" Width="0"/><ColumnDefinition x:Name="HomeRight" Width="0"/></Grid.ColumnDefinitions>
            <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                <Grid x:Name="HomeHeader" Grid.Row="0" Grid.ColumnSpan="3" Margin="0,0,0,20" MinHeight="52">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                    <Border x:Name="HeaderBackdrop" Grid.ColumnSpan="2" Background="{DynamicResource Surface}" BorderBrush="{DynamicResource CardBorder}"
                            BorderThickness="{DynamicResource CardBorderThickness}" CornerRadius="{DynamicResource CardCornerRadius}" Visibility="Collapsed" IsHitTestVisible="False"/>
                    <Border x:Name="HeaderRule" Grid.ColumnSpan="2" Height="1" Background="{DynamicResource Accent}" VerticalAlignment="Bottom" Margin="0,0,0,-8" Visibility="Collapsed"/>
                    <Viewbox x:Name="ComicRays" Grid.ColumnSpan="2" Width="150" Height="56" HorizontalAlignment="Right" Margin="0,0,12,0" IsHitTestVisible="False" Visibility="Collapsed">
                        <Canvas Width="150" Height="56">
                            <Path Data="M150,1 L78,23 L150,10 Z M150,51 L87,32 L150,42 Z" Fill="#FFD629" Stroke="#111820" StrokeThickness="1.5"/>
                            <Path Data="M142,1 L97,21 M149,18 L104,25 M149,33 L105,30 M141,55 L93,35 M70,1 L88,19" Stroke="#111820" StrokeThickness="1.2"/>
                            <Ellipse Canvas.Left="117" Canvas.Top="22" Width="4" Height="4" Fill="#111820"/>
                            <Ellipse Canvas.Left="127" Canvas.Top="27" Width="3" Height="3" Fill="#111820"/>
                            <Ellipse Canvas.Left="136" Canvas.Top="23" Width="2" Height="2" Fill="#111820"/>
                        </Canvas>
                    </Viewbox>
                    <Path x:Name="HeaderOrnament" Data="{DynamicResource HeroOrnament}" Stroke="{DynamicResource Accent}" StrokeThickness="1.4" Width="76" Height="52" Stretch="Uniform"
                          HorizontalAlignment="Right" Margin="0,0,16,0" Opacity="0.22" IsHitTestVisible="False" Visibility="Collapsed"/>
                    <StackPanel x:Name="BrandIdentity" Orientation="Horizontal" VerticalAlignment="Center">
                        <Border Width="48" Height="48" Background="{DynamicResource HeaderBadge}" BorderBrush="{DynamicResource CardBorder}"
                                BorderThickness="{DynamicResource ControlBorderThickness}" CornerRadius="{DynamicResource BadgeCornerRadius}" VerticalAlignment="Center">
                            <Path Data="{DynamicResource IconBrand}" Stroke="{DynamicResource HeaderBadgeText}" StrokeThickness="1.8" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round" Width="24" Height="24" Stretch="Uniform"/>
                        </Border>
                        <StackPanel Margin="14,0,12,0" VerticalAlignment="Center">
                            <TextBlock x:Name="BrandTitle" Text="PinyinTranslate" FontFamily="Segoe UI" FontSize="23" FontWeight="Bold"/>
                            <TextBlock Text="输入、划词和截图，轻松翻译" Foreground="{DynamicResource Muted}" FontSize="12" Margin="0,3,0,0"/>
                        </StackPanel>
                    </StackPanel>
                    <Border x:Name="ThemeStamp" HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,12,0" Padding="8,3" Background="{DynamicResource BadgeScreenshot}"
                            BorderBrush="{DynamicResource CardBorder}" BorderThickness="{DynamicResource ControlBorderThickness}" CornerRadius="{DynamicResource BadgeCornerRadius}" Visibility="Collapsed" IsHitTestVisible="False">
                        <TextBlock x:Name="ThemeStampText" Foreground="{DynamicResource BadgeInk}" FontSize="10" FontWeight="Bold"/>
                    </Border>
                </Grid>

                <Border x:Name="HomeStatus" Grid.Row="1" Grid.ColumnSpan="3" Background="{DynamicResource StatusBackground}" BorderBrush="{DynamicResource StatusBorder}"
                        BorderThickness="{DynamicResource ControlBorderThickness}" CornerRadius="{DynamicResource ControlCornerRadius}"
                        Padding="14,11" Margin="0,0,0,15">
                    <Grid>
                        <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                        <Ellipse Width="7" Height="7" Fill="{DynamicResource Accent}" VerticalAlignment="Top" Margin="0,6,10,0"/>
                        <TextBlock x:Name="StatusText" Grid.Column="1" Foreground="{DynamicResource StatusInk}" TextWrapping="Wrap" FontSize="12"/>
                    </Grid>
                </Border>

                <Border x:Name="FeatureCard" Grid.Row="2" Grid.ColumnSpan="3" Style="{StaticResource Card}" Margin="0,0,0,14">
                    <Grid>
                    <StackPanel>
                        <TextBlock Text="翻译功能" FontSize="17" FontWeight="Bold"/>
                        <StackPanel x:Name="SelectionFeatureRow" Margin="0,13,0,0">
                            <Grid>
                                <Grid.ColumnDefinitions><ColumnDefinition Width="46"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                <Border Style="{StaticResource FeatureBadge}" Background="{DynamicResource BadgeSelection}"><Path Data="{DynamicResource IconSelection}" Stroke="{DynamicResource BadgeInk}" StrokeThickness="1.7" StrokeLineJoin="Round" StrokeStartLineCap="Round" StrokeEndLineCap="Round" Width="19" Height="19" Stretch="Uniform"/></Border>
                                <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="0,0,12,0">
                                    <TextBlock Text="划词翻译" FontSize="14" FontWeight="SemiBold"/>
                                    <TextBlock Text="自动双向翻译 · 读不到时选中后 Ctrl+C" Foreground="{DynamicResource Muted}" FontSize="11" Margin="0,2,0,0" TextWrapping="Wrap"/>
                                </StackPanel>
                                <CheckBox x:Name="SelectionCheck" Grid.Column="2" Style="{StaticResource ModeSwitch}" VerticalAlignment="Center" AutomationProperties.Name="开启划词双向翻译" ToolTip="开启后在本行两种语言之间互译；选中后手动 Ctrl+C 也可翻译本次新复制的文字，终端也可用 Ctrl+Shift+C。关闭后两种方式都停止。" Checked="SelectionChanged" Unchecked="SelectionChanged"/>
                            </Grid>
                            <WrapPanel Margin="46,10,0,0">
                                <StackPanel Width="126" Margin="0,0,10,0">
                                    <TextBlock Text="快捷键" Foreground="{DynamicResource Muted}" FontSize="11" Margin="0,0,0,5"/>
                                    <TextBox x:Name="SelectionShortcut" TextChanged="SettingsEdited" AutomationProperties.Name="划词翻译快捷键"/>
                                </StackPanel>
                                <StackPanel Width="286">
                                <TextBlock Text="互译语言" Foreground="{DynamicResource Muted}" FontSize="11" Margin="0,0,0,5"/>
                                <Grid>
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="112"/><ColumnDefinition Width="22"/><ColumnDefinition Width="112"/><ColumnDefinition Width="40"/></Grid.ColumnDefinitions>
                                    <ComboBox x:Name="SelectionLanguageAChoice" DisplayMemberPath="DisplayName" SelectedValuePath="Code" SelectionChanged="SettingsEdited" AutomationProperties.Name="划词互译左侧语言"/>
                                    <TextBlock Grid.Column="1" Text="↔" FontSize="16" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    <ComboBox x:Name="SelectionLanguageBChoice" Grid.Column="2" DisplayMemberPath="DisplayName" SelectedValuePath="Code" SelectionChanged="SettingsEdited" AutomationProperties.Name="划词互译右侧语言"/>
                                    <Button x:Name="SwapLanguagesButton" Grid.Column="3" Content="⇄" FontSize="17" Padding="4,5" Margin="6,0,0,0" Click="SwapLanguagesClicked" ToolTip="交换两种语言" AutomationProperties.Name="交换划词互译语言"/>
                                </Grid>
                            </StackPanel>
                            </WrapPanel>
                        </StackPanel>

                        <Border Height="1" Background="{DynamicResource Divider}" Opacity="0.35" Margin="0,14,0,0"/>
                        <StackPanel x:Name="ScreenshotFeatureRow" Margin="0,13,0,0">
                            <Grid>
                                <Grid.ColumnDefinitions><ColumnDefinition Width="46"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                <Border Style="{StaticResource FeatureBadge}" Background="{DynamicResource BadgeScreenshot}"><Path Data="{DynamicResource IconCapture}" Stroke="{DynamicResource BadgeInk}" StrokeThickness="1.7" StrokeLineJoin="Round" StrokeStartLineCap="Round" StrokeEndLineCap="Round" Width="19" Height="19" Stretch="Uniform"/></Border>
                                <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="0,0,12,0">
                                    <TextBlock Text="截图翻译" FontSize="14" FontWeight="SemiBold"/>
                                    <TextBlock Text="框选区域查看原文与译文对照" Foreground="{DynamicResource Muted}" FontSize="11" Margin="0,2,0,0" TextWrapping="Wrap"/>
                                </StackPanel>
                                <Button Grid.Column="2" Content="开始截图" Click="CaptureClicked" VerticalAlignment="Center" Background="{DynamicResource PrimaryBackground}" BorderBrush="{DynamicResource ButtonBorder}" Foreground="{DynamicResource PrimaryInk}" FontWeight="SemiBold"/>
                            </Grid>
                            <WrapPanel Margin="46,10,0,0">
                                <StackPanel Width="126" Margin="0,0,10,0">
                                    <TextBlock Text="快捷键" Foreground="{DynamicResource Muted}" FontSize="11" Margin="0,0,0,5"/>
                                    <TextBox x:Name="ScreenshotShortcut" TextChanged="SettingsEdited" AutomationProperties.Name="截图翻译快捷键"/>
                                </StackPanel>
                                <StackPanel Width="200"><TextBlock Text="译为" Foreground="{DynamicResource Muted}" FontSize="11" Margin="0,0,0,5"/><ComboBox x:Name="ScreenshotTargetChoice" DisplayMemberPath="DisplayName" SelectedValuePath="Code" SelectionChanged="SettingsEdited" AutomationProperties.Name="截图翻译目标语言"/></StackPanel>
                            </WrapPanel>
                        </StackPanel>

                        <Border Height="1" Background="{DynamicResource Divider}" Opacity="0.35" Margin="0,14,0,0"/>
                        <StackPanel x:Name="ImeFeatureRow" Margin="0,13,0,0">
                            <Grid>
                                <Grid.ColumnDefinitions><ColumnDefinition Width="46"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                <Border Style="{StaticResource FeatureBadge}" Background="{DynamicResource BadgeIme}"><Path Data="{DynamicResource IconIme}" Stroke="{DynamicResource BadgeInk}" StrokeThickness="1.7" StrokeLineJoin="Round" StrokeStartLineCap="Round" StrokeEndLineCap="Round" Width="19" Height="19" Stretch="Uniform"/></Border>
                                <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="0,0,12,0">
                                    <TextBlock Text="微软拼音翻译" FontSize="14" FontWeight="SemiBold"/>
                                    <TextBlock Text="自动翻译并复制 · Esc 后 Ctrl+V" Foreground="{DynamicResource Muted}" FontSize="11" Margin="0,2,0,0" TextWrapping="Wrap"/>
                                </StackPanel>
                                <CheckBox x:Name="ImeCheck" Grid.Column="2" Style="{StaticResource ModeSwitch}" Checked="ImeChanged" Unchecked="ImeChanged" VerticalAlignment="Center" AutomationProperties.Name="拼音翻译模式开关"/>
                            </Grid>
                            <WrapPanel Margin="46,10,0,0">
                                <StackPanel Width="126" Margin="0,0,10,0">
                                    <TextBlock Text="快捷键" Foreground="{DynamicResource Muted}" FontSize="11" Margin="0,0,0,5"/>
                                    <TextBox x:Name="ImeShortcut" TextChanged="SettingsEdited" AutomationProperties.Name="拼音翻译快捷键"/>
                                </StackPanel>
                                <StackPanel Width="200"><TextBlock Text="译为" Foreground="{DynamicResource Muted}" FontSize="11" Margin="0,0,0,5"/><ComboBox x:Name="ImeTargetChoice" DisplayMemberPath="DisplayName" SelectedValuePath="Code" SelectionChanged="SettingsEdited" AutomationProperties.Name="输入翻译目标语言"/></StackPanel>
                            </WrapPanel>
                        </StackPanel>

                        <DockPanel Margin="0,18,0,0">
                            <Button x:Name="SaveFeatureSettingsButton" DockPanel.Dock="Right" Content="保存设置" Click="SaveSettingsClicked"/>
                            <TextBlock x:Name="ShortcutStatus" Text="修改快捷键或语言后点击保存" Foreground="{DynamicResource Muted}" VerticalAlignment="Center" TextWrapping="Wrap" Margin="0,0,12,0" FontSize="12"/>
                        </DockPanel>
                    </StackPanel>
                    <Border Width="54" Height="12" Background="{DynamicResource PaperTape}" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,-23,18,0" IsHitTestVisible="False" RenderTransformOrigin="0.5,0.5">
                        <Border.RenderTransform><RotateTransform Angle="-7"/></Border.RenderTransform>
                    </Border>
                    <Grid x:Name="ComicSticker" Width="39" Height="32" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,-8,0,0" IsHitTestVisible="False" Visibility="Collapsed">
                        <Path Data="{DynamicResource HeroOrnament}" Fill="{DynamicResource HeaderBadge}" Stroke="{DynamicResource CardBorder}" StrokeThickness="1.5" Stretch="Fill"/>
                        <TextBlock Text="译!" Foreground="{DynamicResource HeaderBadgeText}" FontSize="10" FontWeight="Black" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Grid>
                    </Grid>
                </Border>

                <TextBlock x:Name="HomeFooter" Grid.Row="3" Grid.ColumnSpan="3" Text="关闭窗口将退出程序" Foreground="{DynamicResource Muted}" FontSize="11" Margin="2,0,0,0"/>
        </Grid>
    </ScrollViewer>
    <ContentControl x:Name="SettingsHost" Visibility="Collapsed"/>
    <ContentControl x:Name="StatisticsHost" Visibility="Collapsed"/>
    </Grid>
    </Grid>
</Window>
